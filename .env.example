# is not scoring its own family's output.
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo override: force winter conditions in September.
DEMO_FORCE_OUTDOOR_TEMP_F=
