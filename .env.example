# Vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Origin only, no path — the deploy script derives /api/vapi/tools and /events
VAPI_BASE_URL=
VAPI_WEBHOOK_SECRET=

# Mistral (needs billing enabled — a key without it fails as a Vapi error)
MISTRAL_API_KEY=

# One provider for everything: calls, eval judge, post-call extraction.
# The judge runs magistral-medium-latest while calls run mistral-medium-latest.
# See DECISIONS.md for how same-family judge bias is bounded.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo override: force winter conditions in September.
DEMO_FORCE_OUTDOOR_TEMP_F=

# Shared secret for the dispatch dashboard: /calls?key=<this>
DASH_SECRET=
